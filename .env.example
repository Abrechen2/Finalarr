# Copy to .env for local runs. Real values come from secret store (project `finalarr`).
# API key: at least 20 characters, e.g. `openssl rand -hex 32`.
FINALARR_API_KEY=
# Fernet key: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FINALARR_SECRET_KEY=
FINALARR_LANGUAGE=de
FINALARR_LOG_LEVEL=INFO
# required = login for everyone; local = no login from home networks (10/8, 172.16/12,
# 192.168/16, loopback), key still needed from elsewhere.
FINALARR_AUTH=required
# Set to true only behind HTTPS.
FINALARR_COOKIE_SECURE=false
# Number of reverse proxies in front (1 behind NPM); 0 ignores X-Forwarded-For.
FINALARR_TRUSTED_PROXIES=0
# Public base URL that serves only /ical/ (reverse proxy), shown as the calendar
# subscription address so Google/Outlook can fetch it. Optional.
FINALARR_FEED_URL=
# Address you open Finalarr at; adds "Finalarr" links to messages. Optional.
FINALARR_PUBLIC_URL=
# Optional extra announcement sources (free keys). Unset = source off.
# TMDB: themoviedb.org → Settings → API (v3 key or v4 read token)
FINALARR_TMDB_API_KEY=
# Trakt: trakt.tv/oauth/applications → new application → Client ID
FINALARR_TRAKT_CLIENT_ID=
